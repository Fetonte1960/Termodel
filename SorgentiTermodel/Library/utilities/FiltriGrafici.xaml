<UserControl x:Class="Termodel.utilities.FiltriGrafici"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300">
    <Grid>
        <TreeView x:Name="TreeViewFiltri" Margin="10">
            <!-- Filtro principale per i piani -->
            <TreeViewItem x:Name="FiltroPianiItem" Header="Piani" IsExpanded="True">
            </TreeViewItem>
            <!-- Filtro principale per i Componenti -->
            <TreeViewItem x:Name="FiltroComponentiItem" Header="Componenti" IsExpanded="True">
            </TreeViewItem>
            <!-- Filtro  per i Confini -->
            <TreeViewItem x:Name="FiltroConfiniItem" Header="Confini" IsExpanded="True">
            </TreeViewItem>
            <!-- Filtro  per Divisori -->
            <TreeViewItem x:Name="FiltroSeparazioneItem" Header="Separazione tra vani" IsExpanded="True">
            </TreeViewItem>
            <TreeViewItem x:Name="FiltroLineeCotruzioneItem" Visibility="Collapsed" Header="Linee di cotruzione" IsExpanded="True">
            </TreeViewItem>    
        </TreeView>
    </Grid>
</UserControl>
