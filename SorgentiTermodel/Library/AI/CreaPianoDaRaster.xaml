<Window x:Class="Termodel.AI.CreaPianoDaRaster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crea piano Termodel da raster con AI"
        Width="1080" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#FFF4F5F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF26384A" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Crea un piano Termodel da una pianta raster"
                           Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="L'AI ricostruisce e calibra la geometria; Termodel controlla lo SVG e usa il lettore esistente senza modificarlo."
                           Foreground="#FFDCE6EF" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#FFD4D9DF" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1. Scegli la pianta originale" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Il raster verrà conservato nel progetto per confronti e autotest successivi."
                                   Margin="0,4,0,8" Foreground="#FF52606D" TextWrapping="Wrap"/>
                        <TextBox x:Name="PercorsoRasterTextBox" IsReadOnly="True" MinHeight="48"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <Button Content="Seleziona immagine raster..." Click="SelezionaRaster_Click"
                                Margin="0,8,0,18" Padding="8,5"/>

                        <TextBlock Text="2. Collabora con l'AI" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Copia le istruzioni unificate con gli archivi del progetto e il catalogo materiali, incollale in una chat AI e allega la stessa immagine."
                                   Margin="0,4,0,8" Foreground="#FF52606D" TextWrapping="Wrap"/>
                        <Button Content="Copia istruzioni e cataloghi per la chat AI" Click="CopiaIstruzioni_Click"
                                Margin="0,0,0,18" Padding="8,5" Background="#FFE3F2FD"/>

                        <TextBlock Text="3. Riporta lo SVG definitivo" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Scarica DisegnoInput.svg dalla chat oppure copia il suo codice completo negli appunti."
                                   Margin="0,4,0,8" Foreground="#FF52606D" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Apri SVG..." Click="SelezionaSvg_Click" Padding="8,5" Margin="0,0,8,0"/>
                            <Button Content="Incolla SVG" Click="IncollaSvg_Click" Padding="8,5"/>
                        </StackPanel>

                        <Separator Margin="0,18,0,12"/>
                        <Button Content="Controlla e crea il piano Termodel" Click="Importa_Click"
                                Padding="10,7" FontWeight="SemiBold" Background="#FFC8E6C9"/>
                        <TextBlock x:Name="StatoTextBlock" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="#FF37474F" Text="In attesa della pianta raster."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#FFD4D9DF" BorderThickness="1" CornerRadius="6">
                <TabControl x:Name="AnteprimeTabControl" Margin="8">
                    <TabItem Header="Pianta raster originale">
                        <Grid Background="#FFF7F8FA">
                            <Image x:Name="AnteprimaRaster" Stretch="Uniform" Margin="8"/>
                            <TextBlock x:Name="NessunaAnteprimaTextBlock" Text="Seleziona una pianta raster per visualizzarla qui."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#FF7B8794" FontSize="15"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="SVG definitivo">
                        <TextBox x:Name="SvgTextBox" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="14,0,14,14">
            <TextBlock Text="Controllo bloccante: nessuna linea può avere un'estremità non collegata."
                       Foreground="#FFB3261E" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="Chiudi" Click="Chiudi_Click" Padding="18,6" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
