var valeur:longint;
    address:byte;

procedure MancaKey;
var avar:integer;
    i:integer;
    st:string[80];
    pc:array[0..80] of char;
begin


   {$ifdef dos}
   clrscr;
   write(chr(7));
   gotoxy(8,10);write(W_M(7)); { 'Errore fatale ! La protezione hardware non risponde');}
   gotoxy(8,11);write(W_M(8)); { 'o non ‚ stata introdotta in modo corretto'); }
   gotoxy(8,13);write(W_M(9)); { 'Controllare che la protezione sia inserita nella porta parallela dello');}
   gotoxy(8,14);write(W_M(10)); { 'elaboratore (subito prima del cavo della stampante), in questo caso ‚');}
   gotoxy(8,15);write(W_M(11)); { 'probabile che la stampante sia spenta, occorre accenderla');}
   {$endif}
   {$ifdef win}
   messagebeep(10);
   st:=w_m(7)+w_m(8);{'La chive di protezione non risponde.Verificare l''installazione';}
   strpcopy(pc,st);
   messagebox(0,pc,'Mc4-hvac',mb_ok or mb_iconexclamation);
   {$endif}

   halt;
end;



procedure Micro(var Key:string);
var
  Retour,i:Integer;
  Pstr,loc:string;
  st:string[80];
  pc:array[0..80] of char;

 Begin
    Key:='';
    Retour:=lecture(0,valeur);
    If Retour<>0 then
     begin
        i:=1;
        while (retour <> 0) and (i < 5) do
         begin
            Str(i,Pstr);
            Pstr:='I/'+Pstr+'/10';
            {$R-}
            {$ifdef dos}
            Retour :=SK_COMMAND(Pstr);
            {$endif}

            {$ifdef win}
            Retour :=SK_COMMAND(@Pstr,length(pstr));
            {$endif}
            {$R+}
            i:=i+1;
         end;
        IF Retour = 0 then
         begin
            Key:='Rain';
            {$ifdef dos}
            Retour:=SK_COMMAND('E/hyTAyAjqscoDyada');
            Retour:=SK_COMMAND('E/aAdaUabdcjtNcorc');
            {$endif}
            {$ifdef win}
            pstr:='E/hyTAyAjqscoDyada';
            Retour:=SK_COMMAND(pstr,length(pstr));
            pstr:='E/aAdaUabdcjtNcorc';
            Retour:=SK_COMMAND(pstr,length(pstr));
            {$endif}

         end
        else MancaKey;
     end
    else Key:='Micro';
    {$ifdef win}
    if Key > '' then
     begin
        { la locazione 24 e la locazione per la protezione su windows 1=non abilitato 0=abilitato}
        {$R-}
        if Key='Rain' then
         begin
            Str(PosWin,Loc);
            Pstr:='R/'+Loc;
            Retour :=SK_COMMAND(Pstr,length(pstr));
         end
        else
         begin
            Retour:=Lecture(PosWin,valeur);
            Retour:=Valeur;
         end;
        if Retour = 1 then
         begin
            st:='La chive di protezione non e'' abilitata a funzionare con la versione WINDOWS ';
            strpcopy(pc,st);
            messagebox(0,pc,'Mc4-hvac',mb_ok or mb_iconexclamation);
            halt;
         end;
        {$R+}
     end;
    {$endif}
 end;


Procedure decrementa(VAR Valore : integer;Locazione : integer);
var Retour,ValoreOk : integer;
    Loc,PStr,Key:string;


begin
  Micro(Key);
  if Key='Rain' then
   begin
      Str(Locazione,Loc);
      Pstr:='R/'+Loc;
      {$ifdef dos}
      Retour :=SK_COMMAND(Pstr);
      {$endif}
      {$ifdef win}
      Retour :=SK_COMMAND(Pstr,length(pstr));
      {$endif}
      if (Retour > 1) and (Retour < 300) then
       begin
          Retour := Retour - 1;
          Str(Retour,Pstr);
          Pstr:='W/'+Loc+'/'+Pstr;
          {$ifdef dos}
          Retour :=SK_COMMAND(Pstr);
          {$endif}

          {$ifdef win}
          Retour :=SK_COMMAND(Pstr,length(pstr));
          {$endif}
       end;
   end
  else
   begin
      Retour:=Lecture(Locazione,valeur);
      valore:=valeur;
      if (Valore> 1) and (Valore<300) then
       begin
          Valore := Valore - 1;
          ValoreOk := Ecriture(Locazione,Valore);
       end;
    end;
end;


procedure PassWordKey(VAR Valore : integer;Locazione,Vers : integer);
var  V1,V2,Num1,Num2,num3,num4   : longint;

     carattere,Codice  : String[10];
     C1,c2             : String[5];
     ris               : integer;
     version:longint;
begin

   V1 := Lecture(28,Valeur);  Num1 := Valeur;
   V1 := Lecture(29,Valeur);  Num2 := Valeur;

   V1 := Lecture(25,Valeur);  Num3 := Valeur;
   V1 := Lecture(26,Valeur);  Num4 := Valeur;

   If ( Num1 = Num3 ) AND (Num2 = Num4) then
   begin
     Ris := Ecriture(Locazione,Version);
     Valore := Version;
   end

   else
    begin

      clrscr;

      gotoxy(8,6); write(W_M(1)); {' CHIAVE DISABILITATA ');}
      gotoxy(8,8);write(W_M(2));  {'Inserire codice di abilitazione :');}

      readLN(carattere);
      clrScr;

      C1 := '';  C2 := '';

      V1 := Lecture(25,Valeur);  STR(Valeur,C1);
      V1 := Lecture(26,Valeur);  STR(Valeur,C2);

      Codice := C1+C2;

      if Carattere = Codice then
       begin
         Ris := Ecriture(Locazione,Version);
         Valore := Version;

         V1  := Ecriture(25,Num1);
         V2  := Ecriture(26,Num2);
       end
      else
       begin
         gotoxy(8,10);write(W_M(3)); { ' CODICE ERRATO !!!'); }
         Valeur := 1;
         delay(6000);
         Halt;
       end;
    end;
end;


procedure PassWordKeyRain(VAR Valeur : integer;Locazione,Vers : integer);
var  Num1,Num2,num3,num4   : integer;

     carattere,Codice  : String[10];
     C1,c2             : String[5];
     ris               : integer;
     Loc,PStr          : string;

begin
   Str(Locazione,Loc);

   {$ifdef dos}
   pstr:='R/28';
   Num1 := SK_COMMAND(pstr);
   pstr:='R/29';
   Num2 := SK_COMMAND(pstr);

   pstr:='R/25';
   Num3 := SK_COMMAND(pstr);
   pstr:='R/26';
   Num4 := SK_COMMAND(pstr);
   {$endif}

   {$ifdef win}
   pstr:='R/28';
   Num1 := SK_COMMAND(pstr,length(pstr));
   pstr:='R/29';
   Num2 := SK_COMMAND(pstr,length(pstr));

   pstr:='R/25';
   Num3 := SK_COMMAND(pstr,length(pstr));
   pstr:='R/26';
   Num4 := SK_COMMAND(pstr,length(pstr));
   {$endif}

   If ( Num1 = Num3 ) AND (Num2 = Num4) then
    begin
       Str(vers,Pstr);
       Pstr:='W/'+Loc+'/'+Pstr;
       {$ifdef dos}
       Valeur :=SK_COMMAND(Pstr);
       {$endif}
       {$ifdef win}
       Valeur :=SK_COMMAND(Pstr,length(pstr));
       {$endif}
    end
   else
    begin
      clrscr;
      gotoxy(8,6); write(W_M(1)); {' CHIAVE DISABILITATA ');}
      gotoxy(8,8);write(W_M(2));  {'Inserire codice di abilitazione :');}
      readLN(carattere);
      clrScr;
      C1 := '';  C2 := '';
      {$ifdef dos}
      Valeur:=SK_COMMAND('R/25');  STR(Valeur,C1);
      valeur:=SK_COMMAND('R/26');  STR(Valeur,C2);
      {$endif}
      {$ifdef win}
      pstr:='R/25';
      Valeur:=SK_COMMAND(pstr,length(pstr));  STR(Valeur,C1);
      pstr:='R/26';
      valeur:=SK_COMMAND(pstr,length(pstr));  STR(Valeur,C2);
      {$endif}
      Codice := C1+C2;
      if Carattere = Codice then
       begin
          Str(Vers,Pstr);
          Pstr:='W/'+Loc+'/'+Pstr;
          {$ifdef dos}
          Valeur := SK_COMMAND(Pstr);
          {$endif}
          {$ifdef win}
          Valeur := SK_COMMAND(Pstr,length(pstr));
          {$endif}

          Str(Num1,Pstr);
          Pstr:='W/25/'+Pstr;
          {$ifdef dos}
          Ris := SK_COMMAND(Pstr);
          {$endif}

          {$ifdef win}
          Ris := SK_COMMAND(Pstr,length(pstr));
          {$endif}

          Str(Num2,Pstr);
          Pstr:='W/26/'+Pstr;

          {$ifdef dos}
          Ris := SK_COMMAND(Pstr);
          {$endif}

          {$ifdef win}
          Ris := SK_COMMAND(Pstr,length(pstr));
          {$endif}
       end
      else
       begin
         gotoxy(8,10);write(W_M(3)); { ' CODICE ERRATO !!!'); }
         delay(6000);
         Halt;
       end;
    end;
end;


function  lettura(locazione:byte):integer;

var Retour: integer;
    valore:longint;
    Loc,PStr,Key:string;


begin
  Micro(Key);
  if Key='Rain' then
   begin
      Str(Locazione,Loc);
      Pstr:='R/'+Loc;

      {$ifdef dos}
       Retour:=SK_COMMAND(Pstr);;
      {$endif}
      {$ifdef win}
       Retour:=SK_COMMAND(pstr,length(pstr));;
      {$endif}
   end
  else
   begin
      Retour:=Lecture(Locazione,valore);
      Retour:=Valore;
   end;
  Lettura:=Retour;
end;


Procedure ControlloChiave(var Risultato : INTEGER;Locazione,vers : integer);
Var
   Valore:integer;
   Retour :integer;

   Pstr,Key      : string;

procedure messerrore;
var st:string[80];
   pc:array[0..80] of char;
begin

 {$ifdef dos}
 clrscr;
 write(chr(7));
 gotoxy(8,10);write(W_M(4)); { 'La protezione hardware non ‚ abilitata a funzionare');}
 gotoxy(8,11);write(W_M(5)); { 'con questa realese del programma ');}
 gotoxy(8,14);write(W_M(6)); {'Contattare l''MC4 Software tel. 011 43 43 297 oppure 011 43 43 630');}
 {$endif}
 {$ifdef win}
 st:=w_m(4)+w_m(5); {'La chive di protezione non corrisponde alla versione del programma.Verificare l''installazione';}
 strpcopy(pc,st);
 messagebox(0,pc,'Mc4-hvac',mb_ok or mb_iconexclamation);
 {$endif}
 halt;
end;

Begin
   {$IFDEF PROTETTO}
   {$R-}
   newFmes('key');
   textbackground(0);
   textcolor(7);
   Micro(key);
   if Key='Rain' then
    begin
       {$ifdef dos}
       Retour:=SK_COMMAND('R/0');;
       {$endif}
       {$ifdef win}
       pstr:='R/0';
       Retour:=SK_COMMAND(pstr,length(pstr));;
       {$endif}
       if retour < 0 then MancaKey;
       Risultato:=(Retour div 1492);
       Str(Locazione,Pstr);
       Pstr:='R/'+Pstr;
       {$ifdef dos}
       Retour:=SK_COMMAND(Pstr);
       {$endif}
       {$ifdef win}
       Retour:=SK_COMMAND(Pstr,length(pstr));
       {$endif}
       case retour of
         0 : messErrore;    {chiave non abilitata con questa realise del pgm}
         1 : PassWordKeyRain(Retour,Locazione,vers);   {digitare la passWord per settare la chiave}
       end;
      if Retour < 0 then messErrore;
      if (Retour > 299) and (retour < vers) then messErrore;    {chiave non abilitata con questa realise del pgm}
    end
   else
    begin
       Valeur:=0;
       Retour:=Lecture(0,valeur);
       if retour <> 0 then MancaKey;
       Risultato:=(Valeur div 1492);
       if risultato <> 1 then mancakey;
       Retour:=Lecture(Locazione,valeur);
       case valeur of
         0 : messErrore;    {chiave non abilitata con questa realise del pgm}
         1 : PassWordKey(Valore,Locazione,vers);   {digitare la passWord per settare la chiave}
       end;
      if Valeur < 0 then messErrore;
      if (valeur > 299) and (valeur < vers) then messErrore;    {chiave non abilitata con questa realise del pgm}
    end;
    RestoreFmes;
    {$R+}
    {$ELSE}
    RISULTATO:=1;
    {$ENDIF}
End;

end.

