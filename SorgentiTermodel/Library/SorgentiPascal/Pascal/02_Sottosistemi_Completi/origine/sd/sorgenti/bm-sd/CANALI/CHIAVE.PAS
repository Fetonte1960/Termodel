          IF Risultato = 0 THEN WriteMessage('Error.key', 2);
          IF Retour <> 0 THEN
            BEGIN
              WriteMessage('Error.key', 1);
              Risultato := 0;
            END;
        UNTIL Risultato = 1;

      END;
