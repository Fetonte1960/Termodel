      PROCEDURE WriteMessage(Nome : st80; i : INTEGER);
        VAR f : TEXT;
          Riga : st80;
          k : INTEGER;
        BEGIN
          ASSIGN(f, Nome);
          RESET(f);
          FOR k := 1 TO i DO READLN(f, Riga);
          CLOSE(f);
          WRITE(CHR(7));
          TEXTBACKGROUND(rosso); TEXTCOLOR(bianco);
          GOTOXY(1, 23); WRITE(Riga);
          TEXTBACKGROUND(nero); TEXTCOLOR(bianco); CLREOL;
          DELAY(5000);
          GOTOXY(1, 23); CLREOL;
        END;



      PROCEDURE decrypte(VAR buff, sg : INTEGER);

        CONST
          code_c = 5486;

        TYPE byteptr = ^byte;
          intptr = ^integer;
          ptr_byte = RECORD
                       CASE BOOLEAN OF
                         TRUE: (p : byteptr);
                         FALSE: (offset : INTEGER; segment : INTEGER)
                     END;
          ptr_int = RECORD
                      CASE BOOLEAN OF
                        TRUE: (p : intptr);
                        FALSE: (offset : INTEGER; segment : INTEGER)
                    END;

        VAR b : ptr_byte;

          p : ptr_int;
          OFS, fin, code_ch, code_cl : INTEGER;
          c : BYTE;

        BEGIN

          code_ch := code_c DIV 256;
          code_cl := code_c MOD 256;
          b.segment := 0;
          b.offset := 5;
          b.p^ := 3;

          Decode_Clef;

          p.segment := 0;
          p.offset := 4; OFS := p.p^;
          p.offset := 6; sg := p.p^;
          p.offset := 12; fin := p.p^;
          p.offset := 14; buff := p.p^;

          b.segment := sg;
          b.offset := OFS;

          WHILE b.offset <= fin DO
            BEGIN
              c := b.p^ XOR code_ch;
              b.p^ := c;
              b.offset := b.offset+1;
              c := b.p^ XOR code_cl;
              b.p^ := c;
              b.offset := b.offset+1;
            END

        END;

        {
        ******************************************************************************
        * The following block must appear often in your source.			     *
        * Its function is to destruct the interrupt vectors used by the debugger.    *
        ******************************************************************************
        }

        {
        ******************************************************************************
        * Function  to read a word at a location.				     *
        *  	- Adresse has the value of the location where to write.		     *
        *  	- The range of Adresse is beetwen 0 and 30.			     *
        *  	- The word is stored in Valeur.					     *
        *  	- In return you get:						     *
        *    		-0 If all is done well.					     *
        *    		-2 If the location is out of range.			     *
        *    		-3 If the key is not present.				     *
        ******************************************************************************
        }
      FUNCTION lecture(adresse : BYTE; VAR valeur : INTEGER) : INTEGER;

        TYPE byteptr = ^byte;
          ptr_byte = RECORD
                       CASE BOOLEAN OF
                         TRUE: (p : byteptr);
                         FALSE: (offset : INTEGER; segment : INTEGER)
                     END;
        VAR b, p1, p2, q1, q2 : ptr_byte;
          c : BYTE;
          sg, buff : INTEGER;

        BEGIN

          {
          ******************************************************************************
          * The following block must appear often in your source.			     *
          * Its function is to destruct the interrupt vectors used by the debugger.    *
          ******************************************************************************
          }
          { -------------------------------------------------------------------------- }
          b.segment := 0; b.offset := $46C; c := b.p^;
          b.offset := 7; b.p^ := c;
          b.offset := 13; b.p^ := c;
          { -------------------------------------------------------------------------- }

          decrypte(buff, sg);

          b.segment := 0;
          b.offset := $46C; c := b.p^;
          b.offset := 4; b.p^ := c;
          b.offset := 5; b.p^ := 2;
          b.offset := 12; b.p^ := c XOR adresse;

          b.offset := $46C; c := b.p^;
          b.offset := 6; b.p^ := c;
          b.offset := 13; b.p^ := c;

          b.offset := $46C; c := b.p^;
          b.offset := 7; b.p^ := c;
          b.offset := 14; b.p^ := c;

          decode_clef;

          p1.segment := 0; p2.segment := 0;
          q1.segment := 0; q2.segment := 0;
          p1.offset := 6; q1.offset := 13;
          p2.offset := 7; q2.offset := 14;

          valeur := (p1.p^-q1.p^)+(p2.p^-q2.p^)*256;

          b.offset := 4;
          lecture := b.p^;
        END;




      BEGIN
        REPEAT
          Valeur := 0;
          Risultato := 0;
          CASE Duct OF
            4 : Retour := Lecture(10, valeur); { duct 4   }
            3 : Retour := Lecture(9, valeur); { duct 3   }
            1 : Retour := Lecture(8, valeur); { duct 1-2 }
          END;
          IF Valeur = Version THEN Risultato := 1;

          (*   IF DUCT = 4 THEN
