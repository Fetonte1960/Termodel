            object GroupBox42: TGroupBox
              Left = 0
              Top = 417
              Width = 577
              Height = 72
              Align = alTop
              Caption = 
                '  Il rendiemnto globale dell'#39'impianto deve essere superiore a un' +
                ' valore fissato per legge'
              Font.Charset = DEFAULT_CHARSET
              Font.Color = clWindowText
              Font.Height = -11
              Font.Name = 'MS Sans Serif'
              Font.Style = [fsBold]
              ParentFont = False
              TabOrder = 2
              object Memo6: TMemo
                Left = 2
                Top = 15
                Width = 573
                Height = 55
                Align = alClient
                BorderStyle = bsNone
                Color = clBtnFace
                Font.Charset = DEFAULT_CHARSET
                Font.Color = clWindowText
                Font.Height = -11
                Font.Name = 'MS Sans Serif'
                Font.Style = []
                Lines.Strings = (
                  ''
                  
                    '  Per avvalersi del calcolo semplificato '#232' necessario  il rendim' +
                    'ento complessivo dell'#39'impianto sia superiore a quello che '
                  'sarebbe richiesto con una verifica completa.'
                  
                    '  Tenuto conto degli accorgimenti gi'#224' posti in atto ci'#242' implica ' +
                    'che le tubazioni per il trasporto del fluido vettore siano ben '
                  'isolate e poste all'#39'interno del perimetro '
                  'riscaldato dell'#39'edificio..'
                  '  ')
                ParentFont = False
                TabOrder = 0
              end
              object Button2: TButton
                Left = 848
                Top = 24
                Width = 75
                Height = 25
                Caption = 'Info'
                TabOrder = 1
              end
            end
            object GroupBox43: TGroupBox
              Left = 0
              Top = 137
              Width = 577
              Height = 64
              Align = alTop
              Caption = 
                '  E'#39' necessaria l'#39'installazione di dispositivi di regolazione de' +
                'lla temperatura per singolo locale ( valvole termostatiche sui r' +
                'adiatori )'
              Font.Charset = DEFAULT_CHARSET
              Font.Color = clWindowText
              Font.Height = -11
              Font.Name = 'MS Sans Serif'
              Font.Style = [fsBold]
              ParentFont = False
              TabOrder = 3
              object Memo7: TMemo
                Left = 2
                Top = 15
                Width = 573
                Height = 47
                Align = alClient
                BorderStyle = bsNone
                Color = clBtnFace
                Font.Charset = DEFAULT_CHARSET
                Font.Color = clWindowText
                Font.Height = -11
                Font.Name = 'MS Sans Serif'
                Font.Style = []
                Lines.Strings = (
                  ''
                  
                    '   Implica un costo aggiuntivo che verr'#224' ricuperato in termini d' +
                    'i risparmio energetico')
                ParentFont = False
                TabOrder = 0
              end
              object Button3: TButton
                Left = 672
                Top = 24
                Width = 75
                Height = 25
                Caption = 'Info'
                TabOrder = 1
              end
            end
            object GroupBox44: TGroupBox
              Left = 0
              Top = 201
              Width = 577
              Height = 128
              Align = alTop
              Caption = 
                '  La temperatura media del fluido vettore deve essere inferiore ' +
                'a 60 '#176'C'
              Font.Charset = DEFAULT_CHARSET
              Font.Color = clWindowText
              Font.Height = -11
              Font.Name = 'MS Sans Serif'
              Font.Style = [fsBold]
              ParentFont = False
              TabOrder = 4
              object Memo8: TMemo
                Left = 2
                Top = 15
                Width = 573
                Height = 111
                Align = alClient
                BorderStyle = bsNone
                Color = clBtnFace
                Font.Charset = DEFAULT_CHARSET
                Font.Color = clWindowText
                Font.Height = -11
                Font.Name = 'MS Sans Serif'
                Font.Style = []
                Lines.Strings = (
                  ''
                  
                    '   Con una temperatura inferiore dell'#39'acqua ( tradizionalmente s' +
                    'i operava a 80 '#176'C ) si rende necessaria l'#39'installazione di un '
                  'maggiore numero di elementi '
                  
                    '  per i radiatori che. va considerato nella fase di definizione ' +
                    'del'#39#39'arredamento.'
                  
                    '  Per ovviare a questo inconveniente ,oltre che per conseguire u' +
                    'na uleriore maggiore efficienza e confort ne'#39#39'abitazione '#232' '
                  'possibile installare un impianto '
                  '  a pannelli radianti a pavimento.'
                  
                    '  Questo accorgimento permetter'#224' alla caldaia di operare ad una ' +
                    'temperatura inferiore con una conseguente minore '
                  'dispersione di energia attraverso la '
                  '  canna fumaria.')
                ParentFont = False
                TabOrder = 0
              end
              object Button4: TButton
                Left = 672
                Top = 96
                Width = 75
                Height = 25
                Caption = 'Info'
                TabOrder = 1
              end
            end
            object GroupBox45: TGroupBox
              Left = 0
              Top = 329
              Width = 577
              Height = 88
              Align = alTop
              Caption = 
                '  Il rendiemnto di produzione deve essere superiore a un valore ' +
                'fissato per legge'
              Font.Charset = DEFAULT_CHARSET
              Font.Color = clWindowText
              Font.Height = -11
              Font.Name = 'MS Sans Serif'
              Font.Style = [fsBold]
              ParentFont = False
              TabOrder = 5
              object Memo9: TMemo
                Left = 2
                Top = 15
                Width = 573
                Height = 71
                Align = alClient
                BorderStyle = bsNone
                Color = clBtnFace
                Font.Charset = DEFAULT_CHARSET
                Font.Color = clWindowText
                Font.Height = -11
                Font.Name = 'MS Sans Serif'
                Font.Style = []
                Lines.Strings = (
                  ''
                  
                    '  Per avvalersi del calcolo semplificato '#232' necessario che il gen' +
                    'eratore di calore  ( caldaia ) abbia un rendiemnto superiore a '
                  'quello che sarebbe richiesto con una '
                  'verifica completa.'
                  
                    '  In pratica si rende necessaria l'#39'installazione di una caldaia ' +
                    'a condensazione o altro dispositivo equivalente.'
                  
                    '  Ci'#242' inplica un costo maggiore che verr'#224' ricuperato in termini ' +
                    'di risparmio energetico.')
                ParentFont = False
                TabOrder = 0
              end
              object Button5: TButton
                Left = 672
                Top = 56
                Width = 75
                Height = 25
                Caption = 'Info'
                TabOrder = 1
