    object LFrase1: TLabel
      Left = 9
      Top = 9
      Width = 580
      Height = 39
      Caption = 
        'Valori limite per il fabbisogno annuo di energia primaria per la' +
        ' climatizzazione invernale per metro quadrato di superficie util' +
        'e  '#13#10'dell'#39'edificio espresso in kWh/m2 anno nel caso di nuova ins' +
        'tallazione o ristrutturazione di impianti termici in edifici esi' +
        'stenti '#13#10'(per qualsiasi valore di potenza installata, anche infe' +
        'riore a 100 kW), dove i valori di riferimento sono maggiorati de' +
        'l 50%:'
    end
    object LFrase2: TLabel
      Left = 8
      Top = 188
      Width = 593
      Height = 117
      Caption = 
        'I valori limite riportati in Tabella 1 sono espressi in funzione' +
        ' della zona climatica, cos'#236' come individuata all'#39'articolo 2 del ' +
        'decreto '#13#10'del Presidente della Repubblica 26 agosto 1993, n. 412' +
        ', e del rapporto di forma dell'#39'edificio S/V, dove:'#13#10#13#10'a) S, espr' +
        'essa in metri quadrati, '#232' la superficie che delimita verso l'#39'est' +
        'erno (ovvero verso ambienti non dotati di impianto di  '#13#10'    ris' +
        'caldamento) il volume riscaldato V;'#13#10'b) V '#232' il volume lordo, esp' +
        'resso in metri cubi, delle parti di edificio riscaldate, definit' +
        'o dalle superfici che lo delimitano.'#13#10'    '#13#10'Per valori di S/V co' +
        'mpresi nell'#39'intervallo 0,2 - 0,9 e, analogamente, per gradi gior' +
        'no (GG) intermedi ai limiti delle zone climatiche'#13#10'riportati in ' +
        'tabella si procede mediante interpolazione lineare.'
    end
