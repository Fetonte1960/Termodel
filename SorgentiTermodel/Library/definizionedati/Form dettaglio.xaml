<Window x:Class="Termodel.definizionedati.Form_dettaglio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form Dettaglio"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="10">
        <!-- Bottoni in basso -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Conferma" Width="80" Margin="5" Click="BtnConferma_Click"/>
            <Button Content="Annulla" Width="80" Margin="5" Click="BtnAnnulla_Click"/>
        </StackPanel>

        <!-- Griglia dinamica -->
        <Grid x:Name="AutoFormGrid"/>
    </DockPanel>
</Window>
